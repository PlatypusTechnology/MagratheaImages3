[general]
	use_environment = "dev"

[dev]
	db_host = "mag_sql"
	db_name = "magrathea_sql"
	db_user = "user"
	db_pass = "password"
	logs_path = "/var/www/logs"
	backups_path = "/var/www/backups"
	medias_path = "/var/www/medias"
	cache_path = "/var/www/cache"
	timezone = "America/Sao_Paulo"
	app_url = "http://contacts.magrathea.localhost.com:8080"
	jwt_key = ""
	webp_quick_access = true
	force_uuid = false

[production]
	db_host = "127.0.0.1"
	db_name = "db_name"
	db_user = "db_user"
	db_pass = "password123"
	logs_path = ""
	backups_path = ""
	medias_path = "/var/www/medias"
	cache_path = "/var/www/cache"
	timezone = "America/Sao_Paulo"
	app_url = "https://platypusweb.com"
	jwt_key = ""
	webp_quick_access = true
	force_uuid = false
	; MagratheaPHP 3 sets MySQL's session time_zone to `timezone` on every connection. If this
	; server's MySQL runs in another zone, existing TIMESTAMP values (created_at/updated_at) read
	; back shifted: keep them as before with db_sync_timezone = false (see migration.md)
	; db_sync_timezone = false
